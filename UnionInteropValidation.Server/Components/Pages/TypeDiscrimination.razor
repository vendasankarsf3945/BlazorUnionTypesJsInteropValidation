@page "/type-discrimination"
@inject IJSRuntime JS

<PageTitle>Type Discrimination Methods</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1>Type Discrimination Methods (Property-Based vs. $type Classifier)</h1>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Property-Based Discrimination</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Detected by property existence or values</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-warning btn-sm" @onclick="SendPBSuccess">
                                    First record type without JsonUnion classifier
                                </button>
                                <button class="btn btn-warning btn-sm" @onclick="SendPBError">
                                    Second record type without JsonUnion classifier
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">Type-Based Discrimination ($type Classifier)</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Detected by $type field</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success btn-sm" @onclick="SendTBSuccess">
                                    First record type with JsonUnion classifier
                                </button>
                                <button class="btn btn-success btn-sm" @onclick="SendTBError">
                                    Second record type with JsonUnion classifier
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">JavaScript → C#</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">JavaScript calls C# method with union and returns result</p>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Property-Based</h6>
                            <button class="btn btn-info btn-sm w-100" @onclick="CallCSharpWithPropertyBased">
                                JS invokes .NET with PropertyBased union
                            </button>
                        </div>
                        <div class="col-md-6">
                            <h6>Type-Based</h6>
                            <button class="btn btn-info btn-sm w-100" @onclick="CallCSharpWithTypeBased">
                                JS invokes .NET with TBSuccess
                            </button>
                            <button class="btn btn-info btn-sm w-100 mt-2" @onclick="CallCSharpWithTypeBasedError">JS invokes .NET with TBError</button>
                            <button class="btn btn-danger btn-sm w-100 mt-2" @onclick="CallCSharpWithUnknownType">Reject unknown $type</button>
                            <button class="btn btn-danger btn-sm w-100 mt-2" @onclick="CallCSharpWithoutType">Reject missing $type</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(result))
            {
                <div class="alert alert-success mt-4">
                    <h6>Result:</h6>
                    <pre>@result</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-danger mt-4">
                    <h6>Error:</h6>
                    <p>@errorMsg</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string result = string.Empty;
    private string errorMsg = string.Empty;
    private IJSObjectReference? module;

    private async Task<IJSObjectReference> GetModuleAsync()
    {
        try
        {
            return module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/type-discrimination.js");
        }
        catch (JSException ex)
        {
            throw new InvalidOperationException("Unable to load the type-discrimination JavaScript module.", ex);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/type-discrimination.js");
            }
            catch (Exception ex)
            {
                errorMsg = $"Failed to load module: {ex.Message}";
            }
        }
    }

    private async Task SendPBSuccess()
    {
        try
        {
            ClearMessages();
            PropertyBased union = new PBSuccess("Operation succeeded");
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processPropertyBased", union);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendPBError()
    {
        try
        {
            ClearMessages();
            PropertyBased union = new PBError("Operation failed");
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processPropertyBased", union);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendTBSuccess()
    {
        try
        {
            ClearMessages();
            TypeBased union = new TBSuccess("Operation succeeded");
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processTypeBased", union);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendTBError()
    {
        try
        {
            ClearMessages();
            TypeBased union = new TBError("Operation failed");
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processTypeBased", union);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task CallCSharpWithPropertyBased()
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("callCSharpWithPropertyBased");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task CallCSharpWithTypeBased()
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("callCSharpWithTypeBased");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private Task CallCSharpWithTypeBasedError() => CallCSharpWithType("TBError");
    private Task CallCSharpWithUnknownType() => CallCSharpWithType("UnknownCase");
    private Task CallCSharpWithoutType() => CallCSharpWithType(null);

    private async Task CallCSharpWithType(string? discriminator)
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("callCSharpWithTypeBasedCase", discriminator);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    [JSInvokable]
    public static object HandlePropertyBasedFromJS(System.Text.Json.JsonElement json)
    {
        // PropertyBased(PBSuccess, PBError): same JSON shape — tests ambiguous deserialization
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var union = System.Text.Json.JsonSerializer.Deserialize<PropertyBased>(json, opts);
            return new { status = "deserialized", resolved = union.ToString(), note = "Ambiguous: same shape for PBSuccess and PBError" };
        }
        catch (Exception ex)
        {
            return new { status = "error", error = ex.Message };
        }
    }

    [JSInvokable]
    public static TypeBased HandleTypeBasedFromJS(TypeBased union)
    {
        // $type discriminator resolves the correct case; round-trip the same value
        return union;
    }

    private void ClearMessages()
    {
        result = string.Empty;
        errorMsg = string.Empty;
    }
}

