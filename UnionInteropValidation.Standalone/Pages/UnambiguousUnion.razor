@page "/unambiguous-union"
@inject IJSRuntime JS

@using UnionInteropValidation.Standalone.Models

<PageTitle>Primitive Union Type Round-Trip</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1>Primitive Union Type Round-Trip (int, string)</h1>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">C# → JavaScript</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Send union from C# to JavaScript and observe the JSON format</p>
                    <div class="d-grid gap-2">
                        <button class="btn btn-success" @onclick="SendIntToJS">
                            Integer case arrives as number (Send int 42)
                        </button>
                        <button class="btn btn-success" @onclick="SendStringToJS">
                            String case arrives as string (Send "hello")
                        </button>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">JavaScript → C#</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">JavaScript calls C# method with union and returns result</p>
                    <div class="d-grid gap-2">
                        <button class="btn btn-info" @onclick="ReceiveIntFromJS">
                            Integer union round-trip (JS → .NET)
                        </button>
                        <button class="btn btn-info" @onclick="ReceiveStringFromJS">
                            String union round-trip (JS → .NET)
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(result))
            {
                <div class="alert alert-success mt-4">
                    <h6>Result:</h6>
                    <pre>@result</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-danger mt-4">
                    <h6>Error:</h6>
                    <p>@errorMsg</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string result = string.Empty;
    private string errorMsg = string.Empty;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/unambiguous-union.js");
            }
            catch (Exception ex)
            {
                errorMsg = $"Failed to load JavaScript module: {ex.Message}";
            }
        }
    }

    private async Task SendIntToJS()
    {
        try
        {
            ClearMessages();
            var unionData = new UnambiguousInt(42);
            dynamic jsResult = await module!.InvokeAsync<dynamic>("processUnambiguous", unionData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendStringToJS()
    {
        try
        {
            ClearMessages();
            var unionData = new UnambiguousString("hello");
            dynamic jsResult = await module!.InvokeAsync<dynamic>("processUnambiguous", unionData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task ReceiveIntFromJS()
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await module!.InvokeAsync<dynamic>("receiveInt");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task ReceiveStringFromJS()
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await module!.InvokeAsync<dynamic>("receiveString");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    [JSInvokable]
    public static object HandleUnambiguousFromJS(System.Text.Json.JsonElement json)
    {
        var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        UnionInteropValidation.Standalone.Models.UnambiguousUnion union;
        // Distinguish by JSON value kind of the 'value' field (number vs string)
        if (json.TryGetProperty("value", out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number)
            union = System.Text.Json.JsonSerializer.Deserialize<UnambiguousInt>(json, opts)!;
        else
            union = System.Text.Json.JsonSerializer.Deserialize<UnambiguousString>(json, opts)!;
        var activeCase = union.Value?.GetType().Name ?? "null";
        var description = union.Value switch
        {
            UnambiguousInt i => $"UnambiguousInt: value={i.Value}",
            UnambiguousString s => $"UnambiguousString: value=\"{s.Value}\"",
            _ => "unknown"
        };
        return new { status = "received from JS", activeCase, description };
    }

    private void ClearMessages()
    {
        result = string.Empty;
        errorMsg = string.Empty;
    }
}

