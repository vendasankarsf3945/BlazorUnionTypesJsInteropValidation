@page "/ambiguous-shapes"
@inject IJSRuntime JS

@using UnionInteropValidation.Hosted.Client.Models

<PageTitle>Ambiguous Shapes & Classifier Methods</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1>Ambiguous Shapes & Type Discriminator (With/Without $type Classifier)</h1>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">WITHOUT $type Classifier (Ambiguous)</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Same JSON structure - deserialization may fail or choose wrong case</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-warning btn-sm" @onclick="SendSimpleSuccess">
                                    Property-based ambiguity - SimpleSuccess
                                </button>
                                <button class="btn btn-warning btn-sm" @onclick="SendSimpleError">
                                    Multiple matching cases - SimpleError
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">WITH $type Classifier (Resolved)</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">$type field disambiguates the cases</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success btn-sm" @onclick="SendTaggedSuccess">
                                    Classifier resolves first record case
                                </button>
                                <button class="btn btn-success btn-sm" @onclick="SendTaggedError">
                                    Classifier resolves second record case
                                </button>
                                <button class="btn btn-info btn-sm" @onclick="CallCSharpWithAmbiguous">
                                    Classifier takes precedence over ambiguity
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(result))
            {
                <div class="alert alert-success mt-4">
                    <h6>Result:</h6>
                    <pre>@result</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-danger mt-4">
                    <h6>Error/Ambiguity:</h6>
                    <p>@errorMsg</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string result = string.Empty;
    private string errorMsg = string.Empty;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/ambiguous-shapes.js");
            }
            catch (Exception ex)
            {
                errorMsg = $"Failed to load module: {ex.Message}";
            }
        }
    }

    private async Task SendSimpleSuccess()
    {
        try
        {
            ClearMessages();
            var unionData = new SimpleSuccess("Operation succeeded");
            dynamic jsResult = await module!.InvokeAsync<dynamic>("processAmbiguous", unionData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Ambiguous deserialization issue: {ex.Message}";
        }
    }

    private async Task SendSimpleError()
    {
        try
        {
            ClearMessages();
            var unionData = new SimpleError("Operation failed");
            dynamic jsResult = await module!.InvokeAsync<dynamic>("processAmbiguous", unionData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Ambiguous deserialization issue: {ex.Message}";
        }
    }

    private async Task SendTaggedSuccess()
    {
        try
        {
            ClearMessages();
            var unionData = new TaggedSuccess("Operation succeeded");
            dynamic jsResult = await module!.InvokeAsync<dynamic>("processTagged", unionData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendTaggedError()
    {
        try
        {
            ClearMessages();
            var unionData = new TaggedError("Operation failed");
            dynamic jsResult = await module!.InvokeAsync<dynamic>("processTagged", unionData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task CallCSharpWithAmbiguous()
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await module!.InvokeAsync<dynamic>("callCSharpWithAmbiguous");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    [JSInvokable]
    public static object HandleAmbiguousFromJS(System.Text.Json.JsonElement json)
    {
        var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        // TaggedSuccess and TaggedError share the same JSON shape; first case wins
        TaggedResult union = System.Text.Json.JsonSerializer.Deserialize<TaggedSuccess>(json, opts)!;
        var activeCase = union.Value?.GetType().Name ?? "null";
        var description = union.Value switch
        {
            TaggedSuccess s => $"TaggedSuccess: \"{s.Value}\"",
            TaggedError e => $"TaggedError: \"{e.Value}\"",
            _ => "null active case"
        };
        return new { status = "received from JS", activeCase, description };
    }

    private void ClearMessages()
    {
        result = string.Empty;
        errorMsg = string.Empty;
    }
}

