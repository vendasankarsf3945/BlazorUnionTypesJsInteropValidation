@page "/nested-union"
@inject IJSRuntime JS

@using UnionInteropValidation.Hosted.Client.Models

<PageTitle>Nested Union in Container</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1>Nested Union in Container Object</h1>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">C# ? JavaScript</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-success btn-sm" @onclick="SendUserData">
                                    UserData active case (name + email)
                                </button>
                                <button class="btn btn-success btn-sm" @onclick="SendErrorData">
                                    ErrorData active case (code + message)
                                </button>
                                <button class="btn btn-warning btn-sm" @onclick="SendNullPayload">
                                    Null payload: Container.Payload = null
                                </button>
                                <div class="border-top mt-2 pt-2">
                                    <button class="btn btn-outline-dark btn-sm w-100 mb-1" @onclick="SendNullIntInContainer">
                                        Null int? value inside container
                                    </button>
                                    <button class="btn btn-outline-dark btn-sm w-100 mb-1" @onclick="SendIntInContainer">
                                        Integer 42 inside container
                                    </button>
                                    <button class="btn btn-outline-dark btn-sm w-100" @onclick="SendStringInContainer">
                                        String value inside container
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">JavaScript ? C#</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-info btn-sm" @onclick="CallCSharpWithNestedUnion">
                                    Nested union round-trip (JS ? .NET)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(result))
            {
                <div class="alert alert-success mt-4">
                    <h6>Result:</h6>
                    <pre>@result</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-danger mt-4">
                    <h6>Error:</h6>
                    <p>@errorMsg</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string result = string.Empty;
    private string errorMsg = string.Empty;
    private IJSObjectReference? module;

    private async Task<IJSObjectReference> GetModuleAsync()
    {
        try
        {
            return module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/nested-union.js");
        }
        catch (JSException ex)
        {
            throw new InvalidOperationException("Unable to load the nested-union JavaScript module.", ex);
        }
    }

    private async Task SendUserData()
    {
        try
        {
            ClearMessages();
            var container = new Container
            {
                Payload = new UserData("John Doe", "john@example.com")
            };
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processNested", container);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendErrorData()
    {
        try
        {
            ClearMessages();
            var container = new Container
            {
                Payload = new ErrorData("ERR_001", "Operation failed")
            };
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processNested", container);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task SendNullIntInContainer()
    {
        try
        {
            ClearMessages();
            var container = new NullableContainer { Value = null };
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processPrimitive", container);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private async Task SendIntInContainer()
    {
        try
        {
            ClearMessages();
            var container = new NullableContainer { Value = (UnionInteropValidation.Hosted.Client.Models.NullableUnion)(int?)42 };
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processPrimitive", container);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private async Task SendStringInContainer()
    {
        try
        {
            ClearMessages();
            var container = new NullableContainer { Value = (UnionInteropValidation.Hosted.Client.Models.NullableUnion)"hello" };
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processPrimitive", container);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private async Task SendNullPayload()
    {
        try
        {
            ClearMessages();
            var container = new Container { Payload = null };
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("processNested", container);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    private async Task CallCSharpWithNestedUnion()
    {
        try
        {
            ClearMessages();
            dynamic jsResult = await (await GetModuleAsync()).InvokeAsync<dynamic>("callCSharpWithNestedUnion");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
    }

    [JSInvokable]
    public static Container HandleNestedFromJS(Container container)
    {
        return container;
    }

    private void ClearMessages()
    {
        result = string.Empty;
        errorMsg = string.Empty;
    }
}

