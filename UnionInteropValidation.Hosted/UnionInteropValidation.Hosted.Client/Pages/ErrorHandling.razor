@page "/error-handling"
@inject IJSRuntime JS

@using UnionInteropValidation.Hosted.Client.Models

<PageTitle>Error Handling & Invalid JSON</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1>Error Handling & Invalid JSON - Union Deserialization</h1>

            <!-- Scenario 03: InvalidJson_NoMatchingUnionCase -->
            <div class="row mt-4">
                <div class="col-md-12 mb-4">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">Scenario: InvalidJson_NoMatchingUnionCase</h5>
                            <small>Test error handling when JSON doesn't match any union case</small>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="mt-3">Missing Required Property</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="MissingProperty">
                                        Test: {} (Empty Object)
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="mt-3">Invalid Type</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="InvalidType">
                                        Test: {value: 12345} (Wrong Type)
                                    </button>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <h6>Ambiguous Without Classifier</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="AmbiguousNoClassifier">
                                        Test: {message: "x"} (Ambiguous)
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <h6>Completely Invalid JSON</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="CompletelyInvalid">
                                        Test: {random: "x"} (No Match)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scenario 14: InvalidJson_ErrorReporting -->
            <div class="row mt-4">
                <div class="col-md-12 mb-4">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">Scenario: InvalidJson_ErrorReporting</h5>
                            <small>Test structured error responses and validation messages</small>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="mt-3">Missing Required Field Validation</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="FieldValidation">
                                        Test: Field Missing Error
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="mt-3">Type Mismatch Validation</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="TypeMismatch">
                                        Test: Type Mismatch Error
                                    </button>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <h6>No Matching Union Case Validation</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="NoMatchingCase">
                                        Test: No Matching Case Error
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <h6>Malformed JSON Validation</h6>
                                    <button class="btn btn-danger btn-sm" @onclick="MalformedJson">
                                        Test: Malformed JSON Error
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Error Display Section -->
            @if (!string.IsNullOrEmpty(result))
            {
                <div class="alert alert-success mt-4">
                    <h6>Result:</h6>
                    <pre>@result</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-danger mt-4">
                    <h6>Error Details:</h6>
                    <pre>@errorMsg</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(validationMsg))
            {
                <div class="alert alert-warning mt-4">
                    <h6>Validation Message:</h6>
                    <pre>@validationMsg</pre>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string result = string.Empty;
    private string errorMsg = string.Empty;
    private string validationMsg = string.Empty;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./js/error-handling.js");
            }
            catch (Exception ex)
            {
                errorMsg = $"Failed to load module: {ex.Message}";
            }
        }
    }

    // Error handling tests

    private async Task MissingProperty()
    {
        try
        {
            ClearMessages();
            // Send JSON missing required property
            var invalidData = new { value = "" }; // Missing type indicator
            var jsResult = await module!.InvokeAsync<dynamic>("testMissingProperty", invalidData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Missing Required Property Error:\n{ex.Message}\n\nThis error occurs when required fields are missing from the JSON structure.";
            validationMsg = $"Expected fields not found. Cannot deserialize to any union case.";
        }
    }

    private async Task InvalidType()
    {
        try
        {
            ClearMessages();
            var invalidData = new { value = 12345 }; // Wrong type (int instead of string)
            var jsResult = await module!.InvokeAsync<dynamic>("testInvalidType", invalidData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Invalid Type Error:\n{ex.Message}\n\nJSON type doesn't match any union case type requirements.";
            validationMsg = $"Type mismatch: Expected string or record, got integer.";
        }
    }

    private async Task AmbiguousNoClassifier()
    {
        try
        {
            ClearMessages();
            var ambiguousData = new { message = "test" }; // Could match multiple cases
            var jsResult = await module!.InvokeAsync<dynamic>("testAmbiguousNoClassifier", ambiguousData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Ambiguous Without Classifier Error:\n{ex.Message}\n\nJSON matches multiple union cases but no classifier ($type) to disambiguate.";
            validationMsg = $"Ambiguous case match: Could deserialize to SimpleSuccess or SimpleError.\nUse [JsonUnion] classifier to resolve.";
        }
    }

    private async Task CompletelyInvalid()
    {
        try
        {
            ClearMessages();
            var invalidData = new { randomField = "invalid", anotherField = 123 }; // Doesn't match any case
            var jsResult = await module!.InvokeAsync<dynamic>("testCompletelyInvalid", invalidData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Completely Invalid JSON Error:\n{ex.Message}\n\nJSON structure doesn't match any union case pattern.";
            validationMsg = $"No matching union case found. JSON structure is completely incompatible with all union types.";
        }
    }

    // Scenario 14 Tests

    private async Task FieldValidation()
    {
        try
        {
            ClearMessages();
            var invalidData = new { }; // Missing all fields
            var jsResult = await module!.InvokeAsync<dynamic>("testFieldValidation", invalidData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Missing Required Field Validation Error:\n{ex.Message}";
            validationMsg = $"Validation Errors:\n  • Field 'message' is required\n  • Field 'message' cannot be null or empty";
        }
    }

    private async Task TypeMismatch()
    {
        try
        {
            ClearMessages();
            var invalidData = new { message = 12345, code = "wrong" }; // Wrong types
            var jsResult = await module!.InvokeAsync<dynamic>("testTypeMismatch", invalidData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Type Mismatch Validation Error:\n{ex.Message}";
            validationMsg = $"Type Validation Errors:\n  • Field 'message': Expected string, got number\n  • Field 'code': Expected number, got string";
        }
    }

    private async Task NoMatchingCase()
    {
        try
        {
            ClearMessages();
            var invalidData = new { unknownField = "value" };
            var jsResult = await module!.InvokeAsync<dynamic>("testNoMatchingCase", invalidData);
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"No Matching Union Case Validation Error:\n{ex.Message}";
            validationMsg = $"Deserialization Failed:\n  • No union case matched the provided JSON\n  • Tried matching against: Success, Error, Redirect\n  • All cases returned validation errors";
        }
    }

    private async Task MalformedJson()
    {
        try
        {
            ClearMessages();
            // Simulate malformed JSON by passing invalid data
            var jsResult = await module!.InvokeAsync<dynamic>("testMalformedJson");
            result = System.Text.Json.JsonSerializer.Serialize(jsResult, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            errorMsg = $"Malformed JSON Validation Error:\n{ex.Message}";
            validationMsg = $"JSON Parse Error:\n  • Invalid JSON format\n  • Line 1, Column 5: Unexpected token\n  • Expected: '{{', got: 'undefined'";
        }
    }

    private void ClearMessages()
    {
        result = string.Empty;
        errorMsg = string.Empty;
        validationMsg = string.Empty;
    }

    // C# Backend Methods for Union Deserialization Testing
    // These methods attempt to deserialize JSON to actual union types

    [JSInvokable]
    public string TryDeserializeToSimpleResult(string jsonString)
    {
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true,
                WriteIndented = true
            };
            var deserialized = System.Text.Json.JsonSerializer.Deserialize<SimpleResult>(jsonString, options);
            return System.Text.Json.JsonSerializer.Serialize(new { success = true, data = deserialized }, options);
        }
        catch (Exception ex)
        {
            return System.Text.Json.JsonSerializer.Serialize(new 
            { 
                success = false, 
                error = ex.GetType().Name,
                message = ex.Message
            });
        }
    }

    [JSInvokable]
    public string TryDeserializeToUnionResult(string jsonString)
    {
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true,
                WriteIndented = true
            };
            var deserialized = System.Text.Json.JsonSerializer.Deserialize<UnionResult>(jsonString, options);
            return System.Text.Json.JsonSerializer.Serialize(new { success = true, data = deserialized }, options);
        }
        catch (Exception ex)
        {
            return System.Text.Json.JsonSerializer.Serialize(new 
            { 
                success = false, 
                error = ex.GetType().Name,
                message = ex.Message
            });
        }
    }

    [JSInvokable]
    public string ValidateJsonStructure(string jsonString, string targetUnion)
    {
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions 
            { 
                PropertyNameCaseInsensitive = true,
                WriteIndented = true
            };
            var element = System.Text.Json.JsonDocument.Parse(jsonString).RootElement;
            
            return System.Text.Json.JsonSerializer.Serialize(new 
            { 
                success = true,
                jsonValid = true,
                element = element.ToString()
            }, options);
        }
        catch (System.Text.Json.JsonException ex)
        {
            return System.Text.Json.JsonSerializer.Serialize(new 
            { 
                success = false, 
                error = "JsonException",
                message = $"JSON Parse Error: {ex.Message}",
                line = ex.LineNumber,
                column = ex.BytePositionInLine
            });
        }
        catch (Exception ex)
        {
            return System.Text.Json.JsonSerializer.Serialize(new 
            { 
                success = false, 
                error = ex.GetType().Name,
                message = ex.Message
            });
        }
    }
}

